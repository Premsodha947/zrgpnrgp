@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Cds For RGP & NRGP Gate Pass Proj'
@Metadata.allowExtensions: true
define root view entity ZRGP_NRGP_GATE_PAS_PROJ
  provider contract transactional_query
  as projection on ZRGP_NRGP_GATE_PAS_CDS
{
  key Gateno,
  key fiscalyear,
      Gatetype,
      Plant,
      Department,
      Chalandate,
      Challantime,
      tentativereturndate,
      Duedate,
      Headertext,
      Username,
      Issueby,
      Vehicleno,
      Contactno,
      Partyname,
      Addressline1,
      Addressline2,
      Contactperson,
      Mobilenonumer,
      Valueabue10k,
      Valuebelow10k,
      Approvedby,
      Trancomapnyname,
      Transmobileno,
      Vehicletype,
      L1approval,
      L2approval,
      L3approval,
      L4approval,
      L1approvalremark,
      L2approvalremark,
      L3approvalremark,
      L4approvalremark,
      Lastreceiveddate,
      Lastreceivedtime,
      gatepassdate,
      vendor,
      pono,
      reservation,
      ewaybillno,
      ewaybilldate,
      returnable,
      purpose,
      Remark,
      refgateno,
      gatepass,    
      gateoutremark,
      outnumber,
      Createdby, 
      Createddate,
      Createdtime
}
