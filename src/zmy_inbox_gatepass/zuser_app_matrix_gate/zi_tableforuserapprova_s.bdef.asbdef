managed with additional save implementation in class ZBP_I_TABLEFORUSERAPPROVA_S unique;
strict;
with draft;
define behavior for ZI_TableForUserApprova_S alias TableForUserApprAll
draft table ZUSER_A_GAT_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
//   {
//    validation TableForUserApprova ~ ValidateDataConsistency;
//  }
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TableForUserApprova { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }

}

define behavior for ZI_TableForUserApprova alias TableForUserApprova ##UNMAPPED_FIELD
persistent table ZUSER_A_GATE_TAB
draft table ZUSER_A_GATE__D
lock dependent by _TableForUserApprAll
authorization dependent by _TableForUserApprAll
{
  field ( mandatory : create )
   Tcode,
   Plant,
   Department;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Tcode,
   Plant,
   Department;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

//  factory action ( features : instance ) Copy parameter ZD_CopyTableForUserApprovaP [1];

  mapping for ZUSER_A_GATE_TAB
  {
    Tcode = TCODE;
    Plant = PLANT;
    Department = DEPARTMENT;
    Userid1 = USERID1;
    Userid2 = USERID2;
    Userid3 = USERID3;
    Userid4 = USERID4;
  }

  association _TableForUserApprAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
//  validation ValidateDataConsistency on save { create; update; }

}