@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Cds For RGP & NRGP Gate Pass Root'
@Metadata.ignorePropagatedAnnotations: true
define root view entity ZRGP_NRGP_GATE_PAS_ROT
  as select from zrgp_nrgp_gatepa
  composition [0..*] of zrgp_nrgp_item_CDS as _gateitem
{

  key gateno           as Gateno,
  key fiscalyear,
      gatetype         as Gatetype,
      plant            as Plant,
      department       as Department,
      chalandate       as Chalandate,
      challantime      as Challantime,
      duedate          as Duedate,
      headertext       as Headertext,
      tentativereturndate,
      username         as Username,
      issueby          as Issueby,
      vehicleno        as Vehicleno,
      contactno        as Contactno,
      partyname        as Partyname,
      addressline1     as Addressline1,
      addressline2     as Addressline2,
      contactperson    as Contactperson,
      mobilenonumer    as Mobilenonumer,
      valueabue10k     as Valueabue10k,
      valuebelow10k    as Valuebelow10k,
      approvedby       as Approvedby,
      trancomapnyname  as Trancomapnyname,
      transmobileno    as Transmobileno,
      vehicletype      as Vehicletype,
      l1approval       as L1approval,
      l2approval       as L2approval,
      l3approval       as L3approval,
      l4approval       as L4approval,
      l1approvalremark as L1approvalremark,
      l2approvalremark as L2approvalremark,
      l3approvalremark as L3approvalremark,
      l4approvalremark as L4approvalremark,
      lastreceiveddate as Lastreceiveddate,
      lastreceivedtime as Lastreceivedtime,
      remark           as Remark,
      gatepassdate,
      vendor,
      pono,
      reservation,
      ewaybillno,
      returnable,
      purpose,
      ewaybilldate,
      refgateno,
      gatepass,
      gateoutremark,
      outnumber,
      createdby as Createdby,
      createdtime  as Createdtime,
createddate   as Createddate,
      _gateitem // Make association public
}
